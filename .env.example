# Points at the bundled local PostgreSQL instance that the Electron app
# starts on launch (see electron/main.js in Phase 6). No remote server.
DATABASE_URL="postgresql://gms_user:gms_local_pass@localhost:5432/gms_db?schema=public"

# JWT signing secret — generate a strong random value per install, never commit a real one
JWT_SECRET="replace_with_a_long_random_string"
JWT_EXPIRES_IN="8h"

PORT=4000
NODE_ENV="production"
cd